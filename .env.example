# BreatheWise Environment Variables
# Copy this file to .env and configure values as needed. Never commit .env.

# --- Application ---
APP_NAME=BreatheWise
APP_ENV=development
APP_VERSION=0.1.0
API_V1_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# --- Database (PostgreSQL in Docker/Prod, SQLite async for lightweight local dev) ---
# DATABASE_URL=postgresql+asyncpg://breathewise:breathewise@localhost:5432/breathewise
DATABASE_URL=sqlite+aiosqlite:///./breathewise.db

# --- Qdrant Vector Database ---
# Use :memory: for local dev without external Qdrant, or http://localhost:6333
QDRANT_URL=:memory:
QDRANT_API_KEY=
QDRANT_COLLECTION=breathewise_knowledge

# --- Google Gemini (LLM & Primary Embeddings) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=models/gemini-embedding-001

# --- Local Embeddings Fallback (sentence-transformers when installed) ---
LOCAL_EMBEDDING_MODEL=all-MiniLM-L6-v2

# --- Air Quality Data Providers ---
OPEN_METEO_AQI_URL=https://air-quality-api.open-meteo.com/v1/air-quality
OPEN_METEO_GEOCODE_URL=https://geocoding-api.open-meteo.com/v1/search

# Official CPCB / data.gov.in settings (requires registered api-key from data.gov.in)
CPCB_API_KEY=
CPCB_API_URL=https://api.data.gov.in/resource/3b01bcb8-0b14-4abf-b6f2-c1bfd384ba69

# TTL cache duration in seconds for external AQI requests
AQI_CACHE_TTL_SECONDS=600

# API Rate Limiting (requests per minute per IP; 0 disables)
RATE_LIMIT_PER_MINUTE=120

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:8000/api/v1
